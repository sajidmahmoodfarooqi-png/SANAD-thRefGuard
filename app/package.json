{
  "name": "sanad-refguard",
  "productName": "SANAD",
  "version": "0.2.4",
  "description": "SANAD the RefGuard — a local-first citation companion",
  "license": "AGPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pk.sanad.refguard",
    "productName": "SANAD",
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "extraResources": [
      { "from": "../packaging/dist", "to": "core" },
      { "from": "../docs/SANAD-Guide.html", "to": "SANAD-Guide.html" }
    ],
    "win": { "icon": "../assets/branding/sanad-icon.ico", "target": ["nsis"] },
    "mac": { "icon": "../assets/branding/sanad-icon.icns", "target": ["dmg"], "category": "public.app-category.productivity" },
    "linux": { "icon": "../assets/branding/icon-512.png", "target": ["AppImage"], "category": "Office" }
  }
}
