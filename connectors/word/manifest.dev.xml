<?xml version="1.0" encoding="UTF-8"?>
<!--
  SANAD Word add-in manifest (Office.js) — LOCAL DEVELOPMENT ONLY.

  Points at https://localhost:3000, which only works while a local dev server
  is running (`npx office-addin-debugging start manifest.dev.xml`, or see
  connectors/README.md). If you're setting up the add-in for real use, sideload
  `manifest.xml` instead — that one points at the hosted (GitHub Pages) task
  pane and works with no local server. Sideloading this file when no dev server
  is running produces Word's "can't load the add-in — network/internet" error.

  The <DisplayName> below is suffixed "(dev)" specifically so this manifest is
  visually distinguishable from the production one in Word's My Add-ins list,
  in case both are ever sideloaded at once.

  A thin client of the LOCAL SANAD Core: it inserts citations, rebuilds the
  reference list, and runs the integrity check — writing only inside its own
  tagged content controls, never your prose. The Core stays on 127.0.0.1; only
  this small task-pane UI is served over HTTPS (an Office requirement).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="TaskPaneApp">
  <Id>f2607629-491b-4ac0-806a-f1bc745fdb97</Id>
  <Version>0.2.6.0</Version>
  <ProviderName>SANAD</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SANAD — the RefGuard (dev)" />
  <Description DefaultValue="Insert citations from your local SANAD library, rebuild your reference list, and check citations for integrity — without ever touching your prose. (Local development build.)" />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://localhost:3000/" />

  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
