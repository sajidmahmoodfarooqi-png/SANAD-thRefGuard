<?xml version="1.0" encoding="UTF-8"?>
<!--
  SANAD Word add-in manifest (Office.js).

  A thin client of the local SANAD Core: it inserts citations as tagged content
  controls and runs the integrity check. Office add-ins must be served over
  HTTPS, so `SourceLocation` points at a local dev server during development
  (https://localhost:3000). Replace the Id GUID and the URLs before publishing.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="TaskPaneApp">
  <Id>00000000-0000-0000-0000-000000000000</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>SANAD</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SANAD — the RefGuard" />
  <Description DefaultValue="Insert citations from your local SANAD library and check them for integrity, without ever touching your prose." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://localhost:3000/" />

  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
